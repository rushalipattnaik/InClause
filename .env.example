OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
FLASK_SECRET_KEY=change_this_to_a_random_string
MAX_UPLOAD_MB=15
MAX_CLAUSES=500
RAG_MIN_SIMILARITY=0.40
RAG_MARGIN=0.15
RAG_TOP_K=2
CLASSIFIER=rules
ML_KIND=auto
LEGAL_BERT_DIR=models/legal-bert-risk
# Leave the two HYBRID lines unset to use per-model defaults: Legal-BERT 0.75 and 0.85, other models 0.60 and 0.70.
# Tune them with: python -m eval.run_eval --tune-hybrid
# HYBRID_FLAG_MIN=0.75
# HYBRID_SAFE_MIN=0.85
JOB_TTL_SECONDS=1800
